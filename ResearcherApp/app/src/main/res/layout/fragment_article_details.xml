<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_gray"
    tools:context=".ui.fragment.ArticleDetailsFragment">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/gradient_background" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp"
            android:background="@drawable/card_background"
            android:elevation="6dp"
            android:layout_margin="16dp">

            <TextView
                android:id="@+id/textViewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:textColor="@color/primaryTextColor"
                android:layout_marginBottom="16dp"
                tools:text="Article Title" />

            <TextView
                android:id="@+id/textViewPublished"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textAlignment="center"
                android:textColor="@color/dark_gray"
                android:layout_marginBottom="4dp"
                tools:text="Published: 2024-01-01" />

            <TextView
                android:id="@+id/textViewUpdated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textAlignment="center"
                android:textColor="@color/dark_gray"
                android:layout_marginBottom="20dp"
                tools:text="Updated: 2024-01-05" />

            <TextView
                android:id="@+id/textViewSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:padding="16dp"
                android:textColor="@color/primaryTextColor"
                android:background="@drawable/edittext_background"
                android:elevation="4dp"
                android:layout_marginBottom="24dp"
                tools:text="This is the full summary of the article, explaining all key points and findings in detail." />
            <Button
                android:id="@+id/buttonReadArticle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Read Article"
                android:textColor="@color/primaryTextColor"
                android:backgroundTint="@color/primary"
                android:padding="14dp"
                android:elevation="4dp"
                android:layout_marginTop="16dp"
                app:cornerRadius="18dp"/>

            <Button
                android:id="@+id/buttonDownload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Download PDF"
                android:textColor="@color/primaryTextColor"
                android:backgroundTint="@color/primary"
                android:padding="14dp"
                android:elevation="4dp"
                android:layout_marginTop="16dp"
                app:cornerRadius="18dp"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
